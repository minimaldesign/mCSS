---
import { Code } from 'astro:components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import PricingCard from '../components/PricingCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Faq from '../components/Faq.astro';
import FaqItem from '../components/FaqItem.astro';
import Field from '../components/Field.astro';
import Pagination from '../components/Pagination.astro';
import BaselineBadge from '../components/_BaselineBadge.astro';

import { gzipSync } from 'node:zlib';

import mcssMinCss from '../../dist/mcss.min.css?raw';
import mcssComponentsMinCss from '../../dist/mcss.components.min.css?raw';

import githubIcon from '../assets/icons/social-github.svg?raw';
import replayIcon from '../assets/icons/rotate-ccw.svg?raw';

const title = 'mCSS: One class. Not twenty.';
const description = 'mCSS is a CSS framework and Astro component library for websites: semantic classes, native cascade layers, no build step, MIT licensed. You copy the files into your project and own them.';

// The size claims in the hero fineprint are measured, not remembered: gzip the
// files people actually download, at build time, so they can never drift from
// the framework. Rounded to whole KB, and kept behind a "~" since a host's own
// gzip level (and brotli, which does better) moves the last few hundred bytes.
const mcssMinGzipKb = Math.round(gzipSync(mcssMinCss).length / 1024);
const mcssComponentsMinGzipKb = Math.round(gzipSync(mcssComponentsMinCss).length / 1024);

// The hero morph strikes these one at a time, left to right. The character
// counts in page.home.css (morphCount, --morph-done) follow this list.
const morphUtilities = ['inline-flex', 'items-center', 'justify-center', 'gap-2', 'rounded-md', 'bg-sky-600', 'px-4', 'py-2.5', 'text-sm', 'font-semibold', 'text-white', 'shadow-sm', 'transition-colors', 'duration-200', 'hover:bg-sky-500', 'focus-visible:outline-none', 'focus-visible:ring-2', 'focus-visible:ring-sky-600', 'focus-visible:ring-offset-2', 'active:scale-95', 'disabled:opacity-50', 'dark:bg-sky-500', 'dark:hover:bg-sky-400'];

// Section 2's layer stack, highest priority first. --layer-i counts from the
// bottom, so the stack paints each slab over the one under it.
const cascadeLayers = [
  { name: 'helpers', note: '!important, opt-in', kind: 'helpers' },
  { name: 'your CSS', note: 'no layer', kind: 'yours' },
  { name: 'external', note: 'third-party CSS' },
  { name: 'theme.user', note: 'your theme' },
  { name: 'theme.default', note: 'every design value' },
  { name: 'components', note: 'the component library' },
  { name: 'global', note: 'layouts, prose, a11y' },
  { name: 'elements', note: 'HTML element defaults' },
  { name: 'base', note: 'reset' },
];

// Section 2's override example, rendered with Shiki like the diff panes. The
// @layer statement stays on one line: Shiki's CSS grammar loses track of
// everything after one that spans lines.
const layerProof = `/* mcss.css: the framework's layers, lowest first */
@layer base, elements, global, components, theme.default, theme.user, external, helpers;

/* your CSS: no layer */
/* <a class="bt bt-primary signup_cta"> */
.signup_cta {
  border-radius: 0; /* beats .bt.bt-primary */
}`;

// Section 7's install snippet, with the same measured sizes as the hero.
const installSnippet = `<!-- mCSS, ~${mcssMinGzipKb} KB min+gzip -->
<link rel="stylesheet" href="/css/mcss.min.css" />
<!-- components, ~${mcssComponentsMinGzipKb} KB -->
<link rel="stylesheet" href="/css/mcss.components.min.css" />`;

// Section 4's diff panes, rendered with Shiki (github-dark) at build time.
// Each list matches the overrides in page.home.css line for line.
const themeDiffs = {
  default: `:root {
  --heading-font: var(--display);
  --text: ui-sans-serif, system-ui, sans-serif;
  --text-md: 1rem;
  --text-lg: 1.2rem;
  --text-color: light-dark(#23282e, #d6dbe1);
  --card-bg-color: light-dark(#edeef1, #353c45);
  --card-border-radius: 8px;
  --card-shadow: var(--shadow-md);
  --bt-primary-background-color: #0284c7;
  --bt-primary-background-color-hover: #0ea5e9;
  --bt-primary-border-color: #0284c7;
  --bt-primary-border-color-hover: #0284c7;
  --bt-border-radius: 8px;
  --input-border-radius: 5px;
  --link-color: light-dark(#0284c7, #38bdf8);
}`,
  wireframe: `:root {
  --heading-font: ui-rounded, "Arial Rounded MT Bold", Calibri, sans-serif;
  --text-color: light-dark(#404040, #d4d4d4);
  --card-bg-color: light-dark(#f5f5f5, #171717);
  --card-border-radius: 0;
  --card-shadow: none;
  --bt-primary-background-color: #525252;
  --bt-primary-background-color-hover: #737373;
  --bt-primary-border-color: #525252;
  --bt-primary-border-color-hover: #525252;
  --bt-border-radius: 0;
  --input-border-radius: 0;
  --link-color: light-dark(#525252, #a3a3a3);
}`,
  sunset: `:root {
  --heading-font: "Iowan Old Style", Georgia, serif;
  --text: Georgia, "Times New Roman", serif;
  --text-md: 1.05rem;
  --text-lg: 1.3rem;
  --text-color: light-dark(#431407, #ffedd5);
  --card-bg-color: light-dark(#fef9c3, #431407);
  --card-border-radius: 16px;
  --card-shadow: 0 8px 24px rgb(234 88 12 / 0.25);
  --bt-primary-background-color: #ea580c;
  --bt-primary-background-color-hover: #f97316;
  --bt-primary-border-color: #ea580c;
  --bt-primary-border-color-hover: #ea580c;
  --bt-border-radius: 1e5px;
  --input-border-radius: 1e5px;
  --link-color: light-dark(#c2410c, #fb923c);
}`,
};
---

<BaseLayout title={title} bodyClass="layout home" frontmatter={{ description }}>
  {/* 1: Hero */}
  <section class="home_hero" aria-labelledby="home_hero_title">
    <div class="home_hero_inner">
      <h1 class="home_hero_title" id="home_hero_title">One class. Not&nbsp;twenty.</h1>
      <div class="home_hero_copy">
        <p class="home_hero_subhead">mCSS is a CSS framework and component library for websites. It gives each element one semantic class, keeps its own rules in cascade layers, and needs no build step.</p>
        <p class="home_hero_actions">
          <a class="bt bt-lg bt-primary" href="/docs/start">Get started</a>
          <a class="bt bt-lg" href="https://github.com/minimaldesign/mCSS"><Fragment set:html={githubIcon} />View on GitHub</a>
        </p>
      </div>

      {
        /* The code morph. The animated block is decorative for AT; the srOnly
          line below carries the argument. */
      }
      <div class="home_morph">
        <figure class="home_morph_editor" aria-hidden="true">
          <div class="home_morph_bar">
            <p class="home_morph_label"><span class="home_morph_label_before">Tailwind</span><span class="home_morph_label_after">mCSS</span></p>
            <p class="home_morph_counter"><span class="home_morph_count"></span> characters</p>
          </div>
          {
            /* The invisible sizer keeps the box at the "before" height at every
              width, so the collapse never shifts layout. Syntax spans fake
              Shiki's github-dark (the real thing can't tokenize around the
              animation spans). */
          }
          <div class="home_morph_frame">
            <pre
              class="home_morph_code"><code>&lt;<span class="home_morph_tag">button</span> <span class="home_morph_attr">class</span>=<span class="home_morph_str">"</span><span class="home_morph_after">bt</span>{morphUtilities.map((utility, i) => <span class="home_morph_g" style={`--morph-i: ${i}`}><span class="home_morph_gt">{utility}</span>{i < morphUtilities.length - 1 && ' '}</span>)}<span class="home_morph_str">"</span>&gt;
  Demo button
&lt;/<span class="home_morph_tag">button</span>&gt;</code></pre>
            <pre class="home_morph_code home_morph_sizer"><code>&lt;button class="{morphUtilities.join(' ')}"&gt;
  Demo button
&lt;/button&gt;</code></pre>
          </div>
        </figure>

        {/* Reduced-motion: static before/after with the final numbers */}
        <div class="home_morph_static" aria-hidden="true">
          <p class="home_morph_static_arrow">↓</p>
          <pre class="home_morph_code home_morph_code-after"><code>&lt;<span class="home_morph_tag">button</span> <span class="home_morph_attr">class</span>=<span class="home_morph_str">"</span><span class="home_morph_keep">bt</span><span class="home_morph_str">"</span>&gt;
  Demo button
&lt;/<span class="home_morph_tag">button</span>&gt;</code></pre>
          <p class="home_morph_static_count">388 → 43 characters</p>
        </div>

        <p class="a11y-srOnly">One mCSS class replaces 23 Tailwind utility classes on the same button.</p>

        <button type="button" class="home_morph_replay js-morphReplay"><Fragment set:html={replayIcon} />Replay</button>
      </div>
    </div>
    <ul class="home_hero_fineprint">
      <li>~{mcssMinGzipKb} KB min+gzip</li>
      <li>Components ~{mcssComponentsMinGzipKb} KB</li>
      <li>0 dependencies</li>
      <li><a href="/docs/browser-support">Baseline 2024</a></li>
      <li>MIT licensed</li>
    </ul>
  </section>

  {/* 2: Philosophy */}
  <Section class="home_section home_philosophy" variant="filled" title="Your overrides work the first time" lede="mCSS puts all of its own CSS in native @layer cascade layers, so specificity conflicts never start: anything you write outside those layers wins automatically. No !important, no fighting your framework.">
    <div class="home_layers">
      <div class="home_layers_diagram">
        <p class="home_layers_axis" aria-hidden="true"><span class="home_layers_axisName">Priority</span><span class="home_layers_axisHigh">High</span><span class="home_layers_axisLow">Low</span></p>
        <ol class="home_layers_stack" aria-label="Cascade priority, highest first">
          {
            cascadeLayers.map((layer, i) => (
              <li class:list={['home_layers_layer', layer.kind && `home_layers_layer-${layer.kind}`]} style={`--layer-i: ${cascadeLayers.length - 1 - i}`}>
                <span class="home_layers_slab" aria-hidden="true" />
                <span class="home_layers_label">
                  {layer.kind === 'yours' ? <strong>{layer.name}</strong> : <code>{layer.name}</code>}
                  <span class="home_layers_note">{layer.note}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="home_layers_proof">
        <Code code={layerProof} lang="css" theme="github-dark" wrap />
      </div>
    </div>
  </Section>

  {/* 3: Modern CSS showcase */}
  <Section class="home_section home_showcase" headerClass="home_wideHeader" title="Built with modern CSS" lede="Every feature below works in all current major browsers, and mCSS is designed around them.">
    <div class="home_showcase_body">
      <table class="home_showcase_table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col">What mCSS does with it</th>
            <th scope="col">Support</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><code>@layer</code></th>
            <td>The whole architecture. Import order stops mattering, and your overrides always win.</td>
            <td><BaselineBadge feature="cascade-layers" /></td>
          </tr>
          <tr class="home_showcase_row-lightDark">
            <th scope="row"><code>light-dark()</code></th>
            <td>
              Dark mode lives in the same tokens: each color holds its light and its dark value.
              <label class="home_showcase_mini">
                <input class="toggle" type="checkbox" role="switch" />
                <span>Flip this row’s <code>color-scheme</code></span>
              </label>
            </td>
            <td><BaselineBadge feature="light-dark" /></td>
          </tr>
          <tr>
            <th scope="row"><code>:has()</code> &amp; nesting</th>
            <td>Components with zero specificity hacks, written the way you’d write them yourself.</td>
            <td><BaselineBadge feature="has" /></td>
          </tr>
          <tr>
            <th scope="row"><code>@scope</code></th>
            <td>Prose styling that can’t leak into your components. The one feature here newer than the Baseline 2024 floor.</td>
            <td><BaselineBadge feature="scope" /></td>
          </tr>
          <tr>
            <th scope="row"><code>@container</code></th>
            <td>Layouts that size their columns to the space they’re in.</td>
            <td><BaselineBadge feature="container-queries" /></td>
          </tr>
          <tr>
            <th scope="row">Custom properties</th>
            <td>Three tiers of tokens: raw scales, semantic theme values, and per-component properties.</td>
            <td><BaselineBadge feature="custom-properties" /></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="home_more"><a href="/blog">Learn more about modern CSS practices on the blog →</a></p>
  </Section>

  {/* 4: Theming demo (radio + :has(), zero JS) */}
  <Section class="home_section home_themer" variant="filled" title="Make it your own with built-in themes" lede="Every color, size, and radius comes from one token file, in light and dark. Start from a theme, change a value, and every component that uses it changes with it.">
    <fieldset class="home_themer_switcher">
      <legend class="a11y-srOnly">Pick a demo theme</legend>
      <label class="home_themer_swatch home_themer_swatch-default">
        <input type="radio" name="home_theme" value="default" checked />
        <i aria-hidden="true"></i><span>Default</span>
      </label>
      <label class="home_themer_swatch home_themer_swatch-wireframe">
        <input type="radio" name="home_theme" value="wireframe" />
        <i aria-hidden="true"></i><span>Wireframe</span>
      </label>
      <label class="home_themer_swatch home_themer_swatch-sunset">
        <input type="radio" name="home_theme" value="sunset" />
        <i aria-hidden="true"></i><span>Sunset</span>
      </label>
    </fieldset>

    <div class="home_themer_split">
      <div class="home_themer_stage">
        <Card variant="filled" headingLevel={3} title="You’re invited!" subtitle="Sam’s birthday · Saturday 4pm">
          <p>Cake at Sam’s place. Reply by Thursday so we know how many to expect.</p>
          <Fragment slot="actions">
            <button type="button" class="bt">Details</button>
            <button type="button" class="bt bt-primary">RSVP</button>
          </Fragment>
        </Card>
        <div class="home_themer_formRow">
          <Field label="Email" name="home_themer_email" type="email" placeholder="you@example.com" hint="We’ll never share it." />
          <button type="button" class="bt bt-primary">Subscribe</button>
        </div>
      </div>

      <div>
        <div class="home_themer_pane home_themer_pane-default"><Code code={themeDiffs.default} lang="css" theme="github-dark" /></div>
        <div class="home_themer_pane home_themer_pane-wireframe"><Code code={themeDiffs.wireframe} lang="css" theme="github-dark" /></div>
        <div class="home_themer_pane home_themer_pane-sunset"><Code code={themeDiffs.sunset} lang="css" theme="github-dark" /></div>
      </div>
    </div>
  </Section>

  {/* 5: Component gallery */}
  <Section class="home_section home_gallery" headerClass="home_wideHeader" title="A growing HTML and Astro component library" lede="Heroes, sections, feature grids, pricing, testimonials, FAQs, forms, article lists, and pagination, as plain HTML or as Astro components. Only the mobile menu and the dismissible banner use JavaScript.">
    <ul class="home_gallery_grid">
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Card</p>
        <div class="home_gallery_thumb" inert>
          <Card headingLevel={3} title="Field notes" subtitle="Issue #12">
            <p>A monthly newsletter about CSS and HTML.</p>
            <Fragment slot="actions"><button type="button" class="bt bt-primary">Read it</button></Fragment>
          </Card>
        </div>
        <a class="home_gallery_link" href="/components/card"><span class="a11y-srOnly">Card component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Pricing</p>
        <div class="home_gallery_thumb" inert>
          <PricingCard name="Indie" price="$0" period="/ forever" description="The whole framework." features={['All components', 'Light & dark themes', 'MIT license']} ctaLabel="Copy the files" ctaHref="#" highlighted badge="MIT" />
        </div>
        <a class="home_gallery_link" href="/components/pricing"><span class="a11y-srOnly">Pricing component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Testimonial</p>
        <div class="home_gallery_thumb" inert>
          <Testimonial name="Ada Lindgren" role="Front-end lead">
            <p>I stopped fighting my framework. There was nothing left to fight.</p>
          </Testimonial>
        </div>
        <a class="home_gallery_link" href="/components/testimonial"><span class="a11y-srOnly">Testimonial component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">FAQ</p>
        <div class="home_gallery_thumb" inert>
          <Faq>
            <FaqItem question="Do I need a build step?" name="home_faq" open>No. Link one file and start writing HTML.</FaqItem>
            <FaqItem question="Can I override anything?" name="home_faq">Yes: unlayered CSS always beats the framework.</FaqItem>
          </Faq>
        </div>
        <a class="home_gallery_link" href="/components/faq"><span class="a11y-srOnly">FAQ component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Form field</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_formDemo">
            <Field label="Work email" name="home_gallery_email" type="email" placeholder="you@work.com" hint="One email a month." />
            <button type="button" class="bt bt-primary">Sign up</button>
          </div>
        </div>
        <a class="home_gallery_link" href="/components/field"><span class="a11y-srOnly">Field component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Pagination</p>
        <div class="home_gallery_thumb home_gallery_thumb-wide" inert>
          <Pagination currentPage={4} lastPage={9} baseUrl="#" pageUrl={(p) => `#page-${p}`} />
        </div>
        <a class="home_gallery_link" href="/components/pagination"><span class="a11y-srOnly">Pagination component documentation</span></a>
      </li>
    </ul>
    <p class="home_more">This site (docs, blog, this page) is built from them. <a href="/components/start">Browse all the components →</a></p>
  </Section>

  {/* 6: Ownership */}
  <Section class="home_section home_own" headerClass="home_wideHeader" variant="filled" title="You own the code">
    <div class="home_own_split">
      <div class="home_own_body">
        <p>mCSS doesn’t install from a package registry. You copy the files into your project and edit them like any other code in it. When a default doesn’t suit you, you change that line.</p>
        <ul class="home_own_facts">
          <li><strong>MIT license</strong><span>Use it anywhere. Keep it forever.</span></li>
          <li><strong>Versioned releases</strong><span>Tagged on GitHub and listed in the changelog. Pull updates when you choose to.</span></li>
          <li><strong>One theme file</strong><span>Your design lives in your theme, not in <code>node_modules</code>.</span></li>
        </ul>
      </div>
      <figure class="home_own_tree">
        <figcaption class="a11y-srOnly">The files an mCSS project keeps</figcaption>
        <pre><code>styles/
├── framework/              <span class="home_own_note"># copied once, yours to edit</span>
│   ├── mcss.css
│   ├── settings.*.css
│   ├── base.reset.css
│   ├── elements.*.css      <span class="home_own_note"># 7 files</span>
│   ├── global.*.css        <span class="home_own_note"># 6</span>
│   ├── component.*.css     <span class="home_own_note"># 25</span>
│   ├── help.*.css          <span class="home_own_note"># 7</span>
│   └── theme.*.css         <span class="home_own_note"># the default theme and two more</span>
├── site/
│   ├── <span class="home_own_mine">theme.mysite.css</span>    <span class="home_own_note"># your design lives here</span>
│   └── component.*.css
└── main.css</code></pre>
      </figure>
    </div>
  </Section>

  {/* 7: Install */}
  <Section class="home_section home_install" variant="primary" title="Give your CSS its cascade back" lede="Two lines in your <head> link the framework and, if you want them, the components. The docs cover the other installs, including how to build from source with PostCSS.">
    <div class="home_install_body">
      <Code code={installSnippet} lang="html" theme="github-dark" />
      <p class="home_install_actions">
        <a class="bt bt-lg bt-white home_install_bt" href="/docs/start">Get started</a>
        <a class="bt bt-lg bt-outline-white" href="https://github.com/minimaldesign/mCSS"><Fragment set:html={githubIcon} />View on GitHub</a>
      </p>
      <p class="home_install_newsletter">Prefer email? <a href="https://mcss.ck.page/900e1d8f88" target="mailing-list">Join the mailing list</a> for new components and modern CSS write-ups.</p>
    </div>
  </Section>
</BaseLayout>

{/* The one allowed JS nicety: restart the hero loop. */}
<script>
  const morph = document.querySelector('.home_morph');
  const replay = document.querySelector('.js-morphReplay');
  if (morph && replay) {
    replay.addEventListener('click', () => {
      morph.classList.add('is-resetting');
      void (morph as HTMLElement).offsetWidth;
      morph.classList.remove('is-resetting');
    });
  }
</script>

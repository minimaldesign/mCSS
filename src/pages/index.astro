---
import { Code } from 'astro:components';

import { codeTheme } from '../scripts/codeTheme.js';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import PricingCard from '../components/PricingCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Faq from '../components/Faq.astro';
import FaqItem from '../components/FaqItem.astro';
import Field from '../components/Field.astro';
import Pagination from '../components/Pagination.astro';
import BaselineBadge from '../components/_BaselineBadge.astro';
import CopyButtonStatic from '../components/_CopyButtonStatic.astro';

import { gzipSync } from 'node:zlib';

import mcssMinCss from '../../dist/mcss.min.css?raw';
import mcssComponentsMinCss from '../../dist/mcss.components.min.css?raw';
import defaultTokensCss from '../styles/framework/theme.default.tokens.css?raw';
import defaultUiCss from '../styles/framework/theme.default.ui.css?raw';
import wireframeThemeCss from '../styles/framework/theme.wireframe.css?raw';
import sunsetThemeCss from '../styles/site/theme.sunset.css?raw';

import githubIcon from '../assets/icons/social-github.svg?raw';
import replayIcon from '../assets/icons/rotate-ccw.svg?raw';
import pauseIcon from '../assets/icons/pause.svg?raw';
import playIcon from '../assets/icons/play.svg?raw';

const title = 'mCSS: One class. Not twenty.';
const description = 'mCSS is a CSS framework and Astro component library for websites: semantic classes, native cascade layers, no build step, MIT licensed. You copy the files into your project and own them.';

// The size claims in the hero fineprint are measured, not remembered: gzip the
// files people actually download, at build time, so they can never drift from
// the framework. Rounded to whole KB, and kept behind a "~" since a host's own
// gzip level (and brotli, which does better) moves the last few hundred bytes.
const mcssMinGzipKb = Math.round(gzipSync(mcssMinCss).length / 1024);
const mcssComponentsMinGzipKb = Math.round(gzipSync(mcssComponentsMinCss).length / 1024);

// The hero morph strikes these one at a time, left to right. Everything
// counted about it (classes, characters, the counter's keyframes) is derived
// from this list and the timing below.
const morphUtilities = ['inline-flex', 'items-center', 'justify-center', 'min-w-[101px]', 'min-h-9', 'px-3', 'rounded-lg', 'border', 'border-gray-300', 'bg-white', 'text-sm', 'font-semibold', 'text-gray-900', 'cursor-pointer', 'transition-colors', 'hover:bg-gray-50', 'active:scale-[0.97]', 'disabled:pointer-events-none', 'disabled:opacity-50', 'dark:border-gray-600', 'dark:bg-gray-800', 'dark:text-gray-100', 'dark:hover:bg-gray-900'];
const morphAfter = 'bt';

// Seconds: a pause before the first strike, then one class per --morph-slot,
// each starting --morph-stagger after the previous one (stagger equals slot,
// so they go strictly one at a time: the length of the wait is the point).
const morphTiming = { settle: 1.2, stagger: 0.7, slot: 0.7 };
const morphDone = morphTiming.settle + (morphUtilities.length - 1) * morphTiming.stagger + morphTiming.slot;

// Characters in the code as shown: <button class="…">, the label, </button>
const morphShell = '<button class="">\n  Demo button\n</button>'.length;
const morphBefore = morphShell + morphUtilities.join(' ').length;
const morphAfterLength = morphShell + morphAfter.length;

// The counter steps down as each class collapses (settle + i * stagger +
// slot, as a share of the counter's run, which ends 0.3s after the last
// class), then the empty attribute fills with morphAfter. Keyframe
// percentages can't read custom properties, so they're written out here.
const morphCountCss = (() => {
  const run = morphDone + 0.3;
  const pct = (seconds: number) => +((seconds / run) * 100).toFixed(2);
  let count = morphBefore;
  const steps = ['0%,'];
  morphUtilities.forEach((utility, i) => {
    const collapse = morphTiming.settle + i * morphTiming.stagger + morphTiming.slot;
    steps.push(`${pct(collapse - 0.02)}% { --morph-n: ${count}; }`);
    count -= utility.length + (i < morphUtilities.length - 1 ? 1 : 0);
    steps.push(`${pct(collapse)}%,`);
  });
  steps.push(`${pct(morphDone + 0.1)}% { --morph-n: ${count}; }`, `${pct(morphDone + 0.25)}%, 100% { --morph-n: ${morphAfterLength}; }`);
  return `@property --morph-n { syntax: "<integer>"; inherits: true; initial-value: ${morphBefore}; }
@keyframes morphCount { ${steps.join(' ')} }`;
})();

// Section 2's layer stack, highest priority first. --layer-i counts from the
// bottom, so the stack paints each slab over the one under it.
const cascadeLayers = [
  { name: 'helpers', note: '!important, opt-in', kind: 'helpers' },
  { name: 'your CSS', note: 'no layer', kind: 'yours' },
  { name: 'external', note: 'third-party CSS' },
  { name: 'theme.user', note: 'your theme' },
  { name: 'theme.default', note: 'every design value' },
  { name: 'components', note: 'the component library' },
  { name: 'global', note: 'layouts, prose, a11y' },
  { name: 'elements', note: 'HTML element defaults' },
  { name: 'base', note: 'reset' },
];

// Section 2's override example, rendered with Shiki like the diff panes. The
// @layer statement stays on one line: Shiki's CSS grammar loses track of
// everything after one that spans lines.
const layerProof = `/* mcss.css: the framework's layers, lowest first */
@layer base, elements, global, components, theme.default, theme.user, external, helpers;

/* your CSS: no layer */
/* <a class="bt bt-primary signup_cta"> */
.signup_cta {
  border-radius: 0; /* beats .bt.bt-primary */
}`;

// Section 7's install snippet, with the same measured sizes as the hero.
const installSnippet = `<!-- mCSS, ~${mcssMinGzipKb} KB min+gzip -->
<link rel="stylesheet" href="/css/mcss.min.css" />
<!-- components, ~${mcssComponentsMinGzipKb} KB -->
<link rel="stylesheet" href="/css/mcss.components.min.css" />`;

// Section 4's diff panes, read from the theme files themselves so they can't
// drift: the declarations in their :root blocks, comments stripped, picked by
// name in the order given (all of them when no names are given).
const rootDeclarations = (css: string) => {
  const declarations = new Map<string, string>();
  const bare = css.replace(/\/\*[\s\S]*?\*\//g, '');
  for (const [, body] of bare.matchAll(/:root\s*\{([^}]*)\}/g)) {
    for (const declaration of body.split(';')) {
      const [name, ...value] = declaration.split(':');
      if (name.trim().startsWith('--')) declarations.set(name.trim(), value.join(':').replace(/\s+/g, ' ').trim());
    }
  }
  return declarations;
};
const themeExcerpt = (css: string, names?: string[]) => {
  const declarations = rootDeclarations(css);
  const lines = (names ?? [...declarations.keys()]).filter((name) => declarations.has(name)).map((name) => `  ${name}: ${declarations.get(name)};`);
  return `:root {\n${lines.join('\n')}\n}`;
};
const themeDiffs = {
  default: themeExcerpt(defaultTokensCss + defaultUiCss, ['--text', '--heading-font', '--primary-600', '--border-sm', '--ui-border-color', '--card-border-radius', '--card-shadow', '--bt-border-radius', '--bt-primary-background-color', '--input-border-radius']),
  wireframe: themeExcerpt(wireframeThemeCss, ['--text', '--heading-font', '--heading-weight', '--primary-600', '--border-sm', '--ui-border-color', '--wobble-1', '--wobble-2', '--wobble-3', '--card-border-radius', '--bt-border-radius', '--input-border-radius', '--ui-shadow-color', '--shadow-md']),
  sunset: themeExcerpt(sunsetThemeCss),
};
---

<BaseLayout title={title} bodyClass="layout home" frontmatter={{ description }}>
  {/* 1: Hero */}
  <section class="home_hero" aria-labelledby="home_hero_title">
    <div class="home_hero_inner">
      <h1 class="home_hero_title" id="home_hero_title">One class. Not&nbsp;twenty.</h1>
      <div class="home_hero_copy">
        <p class="home_hero_subhead">mCSS is a CSS framework and component library for websites. It gives each element one semantic class, keeps its own rules in cascade layers, and needs no build step.</p>
        <p class="home_hero_actions">
          <a class="bt bt-lg bt-primary" href="/docs/start">Get started</a>
          <a class="bt bt-lg" href="https://github.com/minimaldesign/mCSS"><Fragment set:html={githubIcon} />View on GitHub</a>
        </p>
      </div>

      {
        /* The code morph. The animated block is decorative for AT; the srOnly
          line below carries the argument. */
      }
      <style is:inline set:html={morphCountCss}></style>
      <div class="home_morph" style={`--morph-count: ${morphUtilities.length}; --morph-settle: ${morphTiming.settle}s; --morph-stagger: ${morphTiming.stagger}s; --morph-slot: ${morphTiming.slot}s`}>
        <figure class="home_morph_editor" aria-hidden="true">
          <div class="home_morph_bar">
            <p class="home_morph_label"><span class="home_morph_label_before">Utility classes</span><span class="home_morph_label_after">mCSS</span></p>
            <p class="home_morph_counter"><span class="home_morph_count" style={`--morph-n: ${morphBefore}`}></span> characters</p>
          </div>
          {
            /* The invisible sizer keeps the box at the "before" height at every
              width, so the collapse never shifts layout. Syntax spans fake
              Shiki's github-dark (the real thing can't tokenize around the
              animation spans). */
          }
          <div class="home_morph_frame">
            <pre
              class="home_morph_code"><code>&lt;<span class="home_morph_tag">button</span> <span class="home_morph_attr">class</span>=<span class="home_morph_str">"</span><span class="home_morph_after">{morphAfter}</span>{morphUtilities.map((utility, i) => <span class="home_morph_g" style={`--morph-i: ${i}`}><span class="home_morph_class home_morph_gt">{utility}</span>{i < morphUtilities.length - 1 && ' '}</span>)}<span class="home_morph_str">"</span>&gt;
  Demo button
&lt;/<span class="home_morph_tag">button</span>&gt;</code></pre>
            <pre class="home_morph_code home_morph_sizer"><code>&lt;button class="{morphUtilities.map((utility, i) => <Fragment><span class="home_morph_class">{utility}</span>{i < morphUtilities.length - 1 && ' '}</Fragment>)}"&gt;
  Demo button
&lt;/button&gt;</code></pre>
          </div>
        </figure>

        {/* Reduced-motion: static before/after with the final numbers */}
        <div class="home_morph_static home_codeBlock" aria-hidden="true">
          <p class="home_morph_static_arrow">↓</p>
          <pre class="home_morph_code"><code>&lt;<span class="home_morph_tag">button</span> <span class="home_morph_attr">class</span>=<span class="home_morph_str">"</span><span class="home_morph_keep">{morphAfter}</span><span class="home_morph_str">"</span>&gt;
  Demo button
&lt;/<span class="home_morph_tag">button</span>&gt;</code></pre>
          <p class="home_morph_static_count">{morphBefore} → {morphAfterLength} characters</p>
        </div>

        <p class="a11y-srOnly">One mCSS class replaces {morphUtilities.length} utility classes on the same button.</p>

        <p class="home_morph_controls">
          <button type="button" class="home_morph_control js-morphPause"><span class="home_morph_pauseIcon"><Fragment set:html={pauseIcon} /></span><span class="home_morph_playIcon"><Fragment set:html={playIcon} /></span><span class="js-morphPauseLabel">Pause</span></button>
          <button type="button" class="home_morph_control js-morphReplay"><Fragment set:html={replayIcon} />Replay</button>
        </p>
      </div>
    </div>
    <ul class="home_hero_fineprint">
      <li>~{mcssMinGzipKb} KB min+gzip</li>
      <li>Components ~{mcssComponentsMinGzipKb} KB</li>
      <li>0 dependencies</li>
      <li><a href="/docs/browser-support">Baseline 2024</a></li>
      <li>MIT licensed</li>
    </ul>
  </section>

  {/* 2: Philosophy */}
  <Section class="home_section home_philosophy" variant="filled" title="Your overrides work the first time" lede="mCSS puts all of its own CSS in native @layer cascade layers, so specificity conflicts never start: anything you write outside those layers wins automatically. No !important, no fighting your framework.">
    <div class="home_layers">
      <div class="home_layers_diagram">
        <p class="home_layers_axis" aria-hidden="true"><span class="home_layers_axisName">Priority</span><span class="home_layers_axisHigh">High</span><span class="home_layers_axisLow">Low</span></p>
        <ol class="home_layers_stack" aria-label="Cascade priority, highest first" style={`--layer-count: ${cascadeLayers.length}`}>
          {
            cascadeLayers.map((layer, i) => (
              <li class:list={['home_layers_layer', layer.kind && `home_layers_layer-${layer.kind}`]} style={`--layer-i: ${cascadeLayers.length - 1 - i}`}>
                <span class="home_layers_slab" aria-hidden="true" />
                <span class="home_layers_label">
                  {layer.kind === 'yours' ? <strong>{layer.name}</strong> : <code>{layer.name}</code>}
                  <span class="home_layers_note">{layer.note}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="home_layers_proof home_codeBlock">
        <Code code={layerProof} lang="css" theme={codeTheme} wrap />
      </div>
    </div>
  </Section>

  {/* 3: Modern CSS showcase */}
  <Section class="home_section home_showcase" headerClass="home_wideHeader" title="Built with modern CSS" lede="The last few years quietly made CSS spectacular. mCSS is what a framework looks like when it’s designed after that happened.">
    <div class="home_showcase_body">
      <table class="home_showcase_table">
        <caption class="a11y-srOnly">Modern CSS features mCSS is built on, and their browser support</caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col">What mCSS does with it</th>
            <th scope="col">Support</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><code>@layer</code></th>
            <td>The whole architecture. Import order stops mattering, and your overrides always win.</td>
            <td><BaselineBadge feature="cascade-layers" /></td>
          </tr>
          <tr class="home_showcase_row-lightDark">
            <th scope="row"><code>light-dark()</code></th>
            <td>
              Dark mode lives in the same tokens: each color holds its light and its dark value.
              <label class="home_showcase_mini">
                <input class="toggle" type="checkbox" role="switch" />
                <span>Flip this row’s <code>color-scheme</code></span>
              </label>
            </td>
            <td><BaselineBadge feature="light-dark" /></td>
          </tr>
          <tr>
            <th scope="row"><code>:has()</code> &amp; nesting</th>
            <td>Components with zero specificity hacks, written the way you’d write them yourself.</td>
            <td><BaselineBadge feature="has" /></td>
          </tr>
          <tr>
            <th scope="row"><code>@scope</code></th>
            <td>Prose styling that can’t leak into your components. The one feature here newer than the Baseline 2024 floor.</td>
            <td><BaselineBadge feature="scope" /></td>
          </tr>
          <tr>
            <th scope="row"><code>@container</code></th>
            <td>Layouts that size their columns to the space they’re in.</td>
            <td><BaselineBadge feature="container-queries" /></td>
          </tr>
          <tr>
            <th scope="row">Custom properties</th>
            <td>Three tiers of tokens: raw scales, semantic theme values, and per-component properties.</td>
            <td><BaselineBadge feature="custom-properties" /></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="home_more"><a href="/blog">Learn more about modern CSS practices on the blog →</a></p>
  </Section>

  {/* 4: Theming demo (radio + :has(), zero JS) */}
  <Section class="home_section home_themer" headerClass="home_wideHeader" variant="filled" title="Make it your own with built-in themes" lede="Every color, size, and radius comes from one token file, in light and dark. Start from a theme, change a value, and every component that uses it changes with it.">
    <fieldset class="home_themer_switcher">
      <legend class="a11y-srOnly">Pick a demo theme</legend>
      <label class="home_themer_swatch home_themer_swatch-default">
        <input type="radio" name="home_theme" value="default" checked />
        <span class="home_themer_dot" aria-hidden="true"></span><span>Default</span>
      </label>
      <label class="home_themer_swatch home_themer_swatch-wireframe">
        <input type="radio" name="home_theme" value="wireframe" />
        <span class="home_themer_dot" aria-hidden="true"></span><span>Wireframe</span>
      </label>
      <label class="home_themer_swatch home_themer_swatch-sunset">
        <input type="radio" name="home_theme" value="sunset" />
        <span class="home_themer_dot" aria-hidden="true"></span><span>Sunset</span>
      </label>
    </fieldset>

    <p class="home_themer_note">A demo: Default and Wireframe ship with mCSS, Sunset is made up for this page.</p>

    <div class="home_themer_split">
      {/* Each theme renders in its own page, with its real CSS file */}
      <div class="home_themer_frames">
        <iframe class="home_themer_frame home_themer_frame-default" src="/demos/themes/default" title="A card and a form in the Default theme" loading="lazy"></iframe>
        <iframe class="home_themer_frame home_themer_frame-wireframe" src="/demos/themes/wireframe" title="A card and a form in the Wireframe theme" loading="lazy"></iframe>
        <iframe class="home_themer_frame home_themer_frame-sunset" src="/demos/themes/sunset" title="A card and a form in the Sunset theme" loading="lazy"></iframe>
      </div>

      <div>
        <figure class="home_themer_pane home_themer_pane-default home_codeBlock">
          <figcaption class="home_themer_file">theme.default.css, excerpt</figcaption>
          <Code code={themeDiffs.default} lang="css" theme={codeTheme} />
        </figure>
        <figure class="home_themer_pane home_themer_pane-wireframe home_codeBlock">
          <figcaption class="home_themer_file">theme.wireframe.css, excerpt</figcaption>
          <Code code={themeDiffs.wireframe} lang="css" theme={codeTheme} />
        </figure>
        <figure class="home_themer_pane home_themer_pane-sunset home_codeBlock">
          <figcaption class="home_themer_file">theme.sunset.css</figcaption>
          <Code code={themeDiffs.sunset} lang="css" theme={codeTheme} />
        </figure>
      </div>
    </div>
  </Section>

  {/* 5: Component gallery */}
  <Section class="home_section home_gallery" headerClass="home_wideHeader" title="A growing HTML and Astro component library" lede="Heroes, sections, feature grids, pricing, testimonials, FAQs, forms, article lists, and pagination, as plain HTML or as Astro components. Most of them need no JavaScript.">
    <ul class="home_gallery_grid">
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Card</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_scale">
          <Card headingLevel={3} title="Field notes" subtitle="Issue #12">
            <p>A monthly newsletter about CSS and HTML.</p>
            <Fragment slot="actions"><button type="button" class="bt bt-primary">Read it</button></Fragment>
          </Card>
          </div>
        </div>
        <a class="home_gallery_link" href="/components/card"><span class="a11y-srOnly">Card component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Pricing</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_scale">
          <PricingCard name="Indie" price="$0" period="/ forever" description="The whole framework." features={['All components', 'Light & dark themes', 'MIT license']} ctaLabel="Copy the files" ctaHref="#" highlighted badge="MIT" />
          </div>
        </div>
        <a class="home_gallery_link" href="/components/pricing"><span class="a11y-srOnly">Pricing component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Testimonial</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_scale">
          <Testimonial name="Ada Lindgren" role="Front-end lead">
            <p>I stopped fighting my framework. There was nothing left to fight.</p>
          </Testimonial>
          </div>
        </div>
        <a class="home_gallery_link" href="/components/testimonial"><span class="a11y-srOnly">Testimonial component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">FAQ</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_scale">
          <Faq>
            <FaqItem question="Do I need a build step?" name="home_faq" open>No. Link one file and start writing HTML.</FaqItem>
            <FaqItem question="Can I override anything?" name="home_faq">Yes: unlayered CSS always beats the framework.</FaqItem>
          </Faq>
          </div>
        </div>
        <a class="home_gallery_link" href="/components/faq"><span class="a11y-srOnly">FAQ component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Form field</p>
        <div class="home_gallery_thumb" inert>
          <div class="home_gallery_scale">
          <div class="home_gallery_formDemo">
            <Field label="Work email" name="home_gallery_email" type="email" placeholder="you@work.com" hint="One email a month." />
            <button type="button" class="bt bt-primary">Sign up</button>
          </div>
          </div>
        </div>
        <a class="home_gallery_link" href="/components/field"><span class="a11y-srOnly">Field component documentation</span></a>
      </li>
      <li class="home_gallery_cell">
        <p class="home_gallery_name">Pagination</p>
        <div class="home_gallery_thumb home_gallery_thumb-centered" inert>
          <div class="home_gallery_scale">
          <Pagination currentPage={3} lastPage={5} baseUrl="#" pageUrl={(p) => `#page-${p}`} />
          </div>
        </div>
        <a class="home_gallery_link" href="/components/pagination"><span class="a11y-srOnly">Pagination component documentation</span></a>
      </li>
    </ul>
    <p class="home_more">This site (docs, blog, this page) is built from them. <a href="/components/start">Browse all the components →</a></p>
  </Section>

  {/* 6: Ownership */}
  <Section class="home_section home_own" variant="filled" aria-labelledby="home_own_title">
    <div class="home_own_split">
      <div class="home_own_body">
        <h2 class="section_title" id="home_own_title">You own the code</h2>
        <p>mCSS doesn’t install from a package registry. You copy its source into your project, build it with PostCSS, and edit it like any other code in it. When a default doesn’t suit you, you change that line.</p>
        <ul class="home_own_facts">
          <li><strong>MIT license</strong><span>Use it anywhere. Keep it forever.</span></li>
          <li><strong>Versioned releases</strong><span>Tagged on GitHub and listed in the changelog. Pull updates when you choose to.</span></li>
          <li><strong>One theme file</strong><span>Your design lives in your theme, not in <code>node_modules</code>.</span></li>
        </ul>
      </div>
      <figure class="home_own_tree home_codeBlock">
        <figcaption class="a11y-srOnly">The files an mCSS project keeps</figcaption>
        <pre><code>styles/
├── framework/              <span class="home_own_note"># copied once, yours to edit</span>
│   ├── mcss.css
│   ├── settings.*.css
│   ├── base.reset.css
│   ├── elements.*.css
│   ├── global.*.css
│   ├── component.*.css
│   ├── help.*.css
│   └── theme.*.css
├── site/
│   ├── <span class="home_own_mine">theme.mysite.css</span>    <span class="home_own_note"># your design lives here</span>
│   └── component.*.css
└── main.css</code></pre>
      </figure>
    </div>
  </Section>

  {/* 7: Install */}
  <Section class="home_section home_install" headerClass="home_install_header" variant="primary" title="Give your CSS its cascade back" lede="Two lines in your <head> link the compiled framework and, if you want them, the components, with no build step. The docs cover the other installs, including how to build from source with PostCSS.">
    <div class="home_install_body">
      <div class="home_install_snippet home_codeBlock" role="region" aria-label="Install snippet">
        <Code code={installSnippet} lang="html" theme={codeTheme} />
        <CopyButtonStatic code={installSnippet} />
      </div>

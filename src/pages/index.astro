{/* The hero morph's controls: pause or resume it, and play it again. */}
<script>
  const morph = document.querySelector('.home_morph');
  const pause = document.querySelector('.js-morphPause');
  const pauseLabel = document.querySelector('.js-morphPauseLabel');
  const replay = document.querySelector('.js-morphReplay');
  if (morph && pause && pauseLabel && replay) {
    const setPaused = (paused: boolean) => {
      morph.classList.toggle('is-paused', paused);
      pauseLabel.textContent = paused ? 'Resume' : 'Pause';
    };
    pause.addEventListener('click', () => setPaused(!morph.classList.contains('is-paused')));
    // The "bt" pulse is the last thing to finish
    morph.querySelector('.home_morph_after')?.addEventListener('animationend', () => morph.classList.add('is-done'));
    replay.addEventListener('click', () => {
      setPaused(false);
      morph.classList.remove('is-done');
      morph.classList.add('is-resetting');
      void (morph as HTMLElement).offsetWidth;
      morph.classList.remove('is-resetting');
    });
  }
</script>
